# Study extent in British National Grid (EPSG:27700): xmin,ymin,xmax,ymax.
# Designations are downloaded for this box, and any AOI inside it can be assessed.
# It covers the region in region/catchments.csv with at least 1 km to spare, and
# runs north to the border so it includes Berwick-upon-Tweed, which drains
# straight into the tidal Tweed and so lies outside the river catchments.
STUDY_BBOX=354000,576000,426000,658000

# Area of interest processed by `make`. Real permission boundaries belong in
# aoi/private/ (gitignored); the committed example is an arbitrary demo polygon.
AOI=aoi/examples/demo_area.geojson

# Margin added around scheduled monuments to absorb handheld GPS error (metres).
GPS_MARGIN_M=10

# Radius for listing nearby heritage records outside the AOI (metres).
CONTEXT_RADIUS_M=250

# Terrain products are cut to the AOI plus this buffer (metres).
TERRAIN_BUFFER_M=150

# Low-pass window for the local relief model (metres).
LRM_WINDOW_M=20

# Resolution of the terrain backdrop on the regional overview (metres). Coarse by
# design: it shows hills and valleys, not earthworks.
REGION_RELIEF_M=50
